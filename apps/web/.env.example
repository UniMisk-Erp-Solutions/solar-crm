# Web app (Vite). Only these three are read by the browser; none of them is a secret.
# Address of the API: your Supabase Edge Function, https://<project-ref>.supabase.co/functions/v1/api (no trailing slash).
# Leave empty for local development (the dev server proxies /api to the local API).
VITE_API_URL=
# Supabase project URL and the PUBLIC anon key (Project Settings > API). Used only for sign-in.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
