# ──────────────────────────────────────────────────────────────
# Future Solar CRM — API environment (copy to apps/api/.env)
# Leave SUPABASE_* empty to run in DEMO MODE: in-memory sample data,
# a role-switcher login screen, mock WhatsApp / SMS / e-mail providers.
# ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000

# Supabase (server side ONLY — the service-role key must never reach the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Force demo mode even when Supabase variables are present (true/false)
DEMO_MODE=

# Session timeout enforced by the API (minutes)
SESSION_TIMEOUT_MINUTES=480

# Providers (only "mock" exists for WhatsApp / SMS / DND / e-invoice / e-way bill until real adapters are added)
WHATSAPP_PROVIDER=mock
SMS_PROVIDER=mock
DND_PROVIDER=mock
EINVOICE_PROVIDER=mock
EWAYBILL_PROVIDER=mock
# E-mail: mock (console) or smtp
EMAIL_PROVIDER=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Future Solar <no-reply@futuresolar.example>"

# Limits
PUBLIC_RATE_LIMIT_PER_MIN=30
AUTH_RATE_LIMIT_PER_15MIN=30
MAX_UPLOAD_MB=10
RUN_JOBS=true

# Secret for signed file links in demo storage (set a long random string in production-like setups)
FILE_TOKEN_SECRET=

# Secret that signs the one-click unsubscribe links in outbound messages (set a long random string in production)
UNSUBSCRIBE_TOKEN_SECRET=

# --- Supabase Edge Function ---
# Shared secret the database scheduler (pg_cron, supabase/sql/14_cron.sql) sends to /internal/cron. Must equal the vault secret "cron_secret".
# Set it with:  npx supabase secrets set CRON_SECRET=...   (SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase itself)
CRON_SECRET=

# E-mail to distributors (request with accept / decline links). Resend works from a Supabase Edge Function; SMTP does not.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM=Future Solar <onboarding@resend.dev>   # use an address on a domain verified at resend.com/domains to reach any recipient
# APP_URL=https://your-app.vercel.app                # only if the request carries no Origin header
